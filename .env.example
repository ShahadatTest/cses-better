# ========================================================
# CSES Better - Production & Vercel Environment Variables
# ========================================================

# Public App URL (set to your Vercel URL in production, e.g. https://cses-better.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OnlineCompiler.io Execution Engine (Piston v2 compatible)
COMPILER_API_KEY=your_compiler_api_key_here
COMPILER_BASE_URL=https://api.onlinecompiler.io/api/v2/piston
NEXT_PUBLIC_ONLINECOMPILER_WIDGET_KEY=your_widget_key_here

# Supabase Auth & Multi-Tenant Database (Google & GitHub OAuth)
# Optional: Guest mode works out of the box if these are omitted.
# Required: For public user authentication and cross-device cloud persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Official CSES.fi Bot Credentials (for shared server-side scraping & live judging)
# Defaults to verified bot account 'csesbetter99' if omitted.
CSES_BOT_NICK=csesbetter99
CSES_BOT_PASS=SecretPass12345!

# Optional: Static CSES PHPSESSID cookie to bypass cold-start login handshakes on Vercel
# CSES_SESSION_COOKIE=PHPSESSID=...
